# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ks_pmt_db
DB_SSL=false
DB_POOL_MAX=20

# JWT Authentication
JWT_ACCESS_SECRET=ks_pmt_jwt_super_secret_access_key_2026_change_in_prod
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=ks_pmt_jwt_super_secret_refresh_key_2026_change_in_prod
JWT_REFRESH_EXPIRATION=7d

# Mobile OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
# When mock mode is true, OTP will be printed to server console
OTP_MOCK_DISPATCH=true
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key

# AWS S3 Storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=ks-pmt-attachments-prod
AWS_S3_PRESIGNED_URL_EXPIRES=900

# Redis Cache / Rate Limiting (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
