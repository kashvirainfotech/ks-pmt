# ========================================================
# Git Ignore Configuration for KS-PMT
# Covers: Backend (Node.js/NestJS), Frontend (React/Vite), 
#         Mobile (Flutter Android/iOS), and Environment Files
# ========================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Build Outputs & Compilations
dist/
*/dist/
build/
*/build/
out/
*/out/
*.tsbuildinfo

# Environment & Sensitive Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Flutter & Mobile Artifacts
.dart_tool/
*/.dart_tool/
.packages
*/.packages
.pub-cache/
.pub/
*/.pub/

# Android Specific
**/android/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# iOS Specific
**/ios/**/GeneratedPluginRegistrant.h
**/ios/**/GeneratedPluginRegistrant.m
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Pods/
**/ios/.symlinks/
**/ios/Podfile.lock
**/ios/**/Pods/

# Temporary / Scratch Files
tmp/
temp/
.temp/
.cache/
